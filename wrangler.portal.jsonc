{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitrew-com",
  "account_id": "ee47884b4794b0240647bfa7a3e56c0b",
  "main": "backend/cloudflare.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "gitrew.com", "custom_domain": true }],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/health", "/github/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitrew-public",
      "database_id": "e399877b-aac9-49ab-9ddb-381142bbc4fc",
    },
  ],
  "vars": {
    "PUBLIC_MODE": "true",
    "PUBLIC_APP": "false",
    "SANDBOX_ORGANIZATION": "",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
}
