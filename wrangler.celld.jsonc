{
  "name": "gitrew-local",
  "main": "dist/backend-worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitrew-local",
      "database_id": "gitrew-local",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }],
  },
  "migrations": [{ "tag": "live-v1", "new_sqlite_classes": ["LiveHub"] }],
  "vars": { "PUBLIC_APP": "false", "SANDBOX_ORGANIZATION": "" },
}
