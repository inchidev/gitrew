# Optional media provider. Keep .env private; it is ignored by Git.
HUDDLE_PROVIDER=
RTK_ACCOUNT_ID=
RTK_APP_ID=
RTK_API_TOKEN=
RTK_PRESET=group_call_participant
# Alternative: your own LiveKit server or LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Web Push: generate a stable pair using node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
