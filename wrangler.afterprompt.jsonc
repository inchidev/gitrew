{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitrew-afterprompt",
  "account_id": "ee47884b4794b0240647bfa7a3e56c0b",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "afterprompt.gitrew.com", "custom_domain": true }],
  "main": "backend/cloudflare.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitrew-afterprompt",
      "database_id": "4a767806-ce35-4d76-92fe-300c8e83116e",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }],
  },
  "migrations": [{ "tag": "live-v1", "new_sqlite_classes": ["LiveHub"] }],
  "vars": {
    "APP_ORIGIN": "https://afterprompt.gitrew.com",
    "APP_NAME": "Gitrew inchidev AfterPrompt",
    "ALLOWED_TEAM": "afterprompt",
    "PUBLIC_APP": "false",
    "SANDBOX_ORGANIZATION": "",
    "HUDDLE_PROVIDER": "realtimekit",
    "RTK_ACCOUNT_ID": "ee47884b4794b0240647bfa7a3e56c0b",
    "RTK_APP_ID": "a283ff1a-0161-4d41-910c-068964628b1e",
    "RTK_PRESET": "gitrew_voice",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
}
